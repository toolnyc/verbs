<script>
  // AJAX DJ form submission to preserve other form state
  const addDjForm = document.getElementById('add-dj-form') as HTMLFormElement;

  if (addDjForm) {
    addDjForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const eventId = addDjForm.dataset.eventId;
      const djSelect = document.getElementById('dj-select') as HTMLSelectElement;
      const newDjName = document.getElementById('new-dj-name') as HTMLInputElement;
      const slotStart = document.getElementById('slot-start') as HTMLInputElement;
      const slotEnd = document.getElementById('slot-end') as HTMLInputElement;
      const submitBtn = document.getElementById('add-dj-btn') as HTMLButtonElement;
      const statusEl = document.getElementById('add-dj-status') as HTMLElement;

      const djId = djSelect?.value || '';
      const newName = newDjName?.value?.trim() || '';

      if (!djId && !newName) {
        statusEl.textContent = 'Select a DJ or enter a new name';
        statusEl.className = 'add-dj-status text-sm ml-sm error';
        return;
      }

      submitBtn.disabled = true;
      statusEl.textContent = 'Adding...';
      statusEl.className = 'add-dj-status text-sm ml-sm';

      try {
        const res = await fetch('/api/admin/event-djs', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event_id: eventId,
            dj_id: djId || undefined,
            new_dj_name: newName || undefined,
            slot_start: slotStart?.value || undefined,
            slot_end: slotEnd?.value || undefined,
          }),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          // Add the new DJ to the list
          const djsList = document.getElementById('djs-list');
          if (djsList && data.eventDj) {
            const djItem = createDjItemElement(data.eventDj);
            djsList.appendChild(djItem);
          }

          // If a new DJ was created, add to select (if select exists)
          if (data.newDj && djSelect) {
            const option = document.createElement('option');
            option.value = data.newDj.id;
            option.textContent = data.newDj.name;
            djSelect.appendChild(option);
          }

          // Remove the added DJ from select options
          if (djId && djSelect) {
            const option = djSelect.querySelector(`option[value="${djId}"]`);
            if (option) option.remove();
          }

          // Clear form inputs
          if (djSelect) djSelect.value = '';
          if (newDjName) newDjName.value = '';
          if (slotStart) slotStart.value = '';
          if (slotEnd) slotEnd.value = '';

          statusEl.textContent = 'Added!';
          statusEl.className = 'add-dj-status text-sm ml-sm success';
          setTimeout(() => { statusEl.textContent = ''; }, 2000);
        } else {
          statusEl.textContent = data.error || 'Failed to add DJ';
          statusEl.className = 'add-dj-status text-sm ml-sm error';
        }
      } catch (err) {
        statusEl.textContent = 'Network error';
        statusEl.className = 'add-dj-status text-sm ml-sm error';
      }

      submitBtn.disabled = false;
    });
  }

  // Create a DJ item element dynamically
  function createDjItemElement(eventDj: any) {
    const div = document.createElement('div');
    div.className = 'dj-item';
    div.dataset.eventDjId = eventDj.id;
    const hasTimes = eventDj.slot_start || eventDj.slot_end;

    div.innerHTML = `
      <div class="dj-info">
        <div class="dj-header">
          <span class="dj-name">${eventDj.dj?.name || 'Unknown'}</span>
          ${hasTimes ? `<span class="dj-times-display">${eventDj.slot_start || '?'} — ${eventDj.slot_end || '?'}</span>` : ''}
        </div>
        <div class="dj-times-container" data-has-times="${hasTimes ? 'true' : 'false'}">
          <button type="button" class="dj-times-toggle text-sm" data-event-dj-id="${eventDj.id}">
            ${hasTimes ? 'Edit times' : '+ Set times'}
          </button>
          <div class="dj-times-inputs" style="${hasTimes ? '' : 'display: none;'}">
            <div class="time-inputs">
              <input type="time" name="slot_start" value="${eventDj.slot_start || ''}" placeholder="Start" class="time-input" data-event-dj-id="${eventDj.id}" />
              <span class="time-separator">—</span>
              <input type="time" name="slot_end" value="${eventDj.slot_end || ''}" placeholder="End" class="time-input" data-event-dj-id="${eventDj.id}" />
            </div>
          </div>
        </div>
      </div>
      <form method="POST" class="inline-form">
        <input type="hidden" name="action" value="remove_dj" />
        <input type="hidden" name="event_dj_id" value="${eventDj.id}" />
        <button type="submit" class="btn-sm secondary">Remove</button>
      </form>
    `;

    // Add toggle listener
    const toggle = div.querySelector('.dj-times-toggle') as HTMLButtonElement;
    const inputs = div.querySelector('.dj-times-inputs') as HTMLElement;
    if (toggle && inputs) {
      toggle.addEventListener('click', () => {
        const isHidden = inputs.style.display === 'none';
        inputs.style.display = isHidden ? '' : 'none';
        toggle.textContent = isHidden ? '- Hide times' : '+ Set times';
      });
    }

    // Set up autosave for time inputs (function defined later in script)
    if (typeof setupDjTimesAutosave === 'function') {
      setupDjTimesAutosave(div);
    }

    return div;
  }

  // Toggle tier edit forms
  document.querySelectorAll('.tier-edit-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const tierId = (btn as HTMLElement).dataset.tierId;
      const form = document.getElementById(`edit-tier-${tierId}`);
      if (form) {
        const isHidden = form.style.display === 'none';
        form.style.display = isHidden ? 'block' : 'none';
        btn.textContent = isHidden ? 'Cancel' : 'Edit';
      }
    });
  });

  // Toggle DJ times inputs for existing DJs
  document.querySelectorAll('.dj-times-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const container = btn.closest('.dj-times-container');
      const inputs = container?.querySelector('.dj-times-inputs') as HTMLElement;
      if (inputs) {
        const isHidden = inputs.style.display === 'none';
        inputs.style.display = isHidden ? '' : 'none';
        const hasTimes = container?.getAttribute('data-has-times') === 'true';
        btn.textContent = isHidden ? '- Hide times' : (hasTimes ? 'Edit times' : '+ Set times');
      }
    });
  });

  // Toggle add DJ times inputs
  const addDjTimesToggle = document.getElementById('add-dj-times-toggle');
  const addDjTimesInputs = document.getElementById('add-dj-times-inputs');
  if (addDjTimesToggle && addDjTimesInputs) {
    addDjTimesToggle.addEventListener('click', () => {
      const isHidden = addDjTimesInputs.style.display === 'none';
      addDjTimesInputs.style.display = isHidden ? '' : 'none';
      addDjTimesToggle.textContent = isHidden ? '- Hide set times' : '+ Add set times';
    });
  }

  // Copy door URL to clipboard
  const copyUrlBtn = document.getElementById('copy-url-btn');
  const doorUrl = document.getElementById('door-url');

  if (copyUrlBtn && doorUrl) {
    copyUrlBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(doorUrl.textContent || '');
        const originalText = copyUrlBtn.textContent;
        copyUrlBtn.textContent = 'Copied!';
        setTimeout(() => {
          copyUrlBtn.textContent = originalText;
        }, 2000);
      } catch (err) {
        console.error('Failed to copy:', err);
      }
    });
  }

  // Toast notification helper
  function showToast(message: string, type: 'success' | 'error' = 'success') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    toast.textContent = message;
    container.appendChild(toast);

    setTimeout(() => {
      toast.classList.add('fade-out');
      setTimeout(() => toast.remove(), 300);
    }, 1500);
  }

  // Tier autosave on blur
  document.querySelectorAll('.tier-autosave-input').forEach(input => {
    const inputEl = input as HTMLInputElement;
    let originalValue = inputEl.value;

    inputEl.addEventListener('focus', () => {
      originalValue = inputEl.value;
    });

    inputEl.addEventListener('blur', async () => {
      if (inputEl.value === originalValue) return;

      const tierForm = inputEl.closest('.tier-edit-form') as HTMLElement;
      const tierId = tierForm?.dataset.tierId;
      if (!tierId) return;

      const field = inputEl.dataset.field;
      if (!field) return;

      try {
        const body: Record<string, any> = {};
        body[field] = inputEl.value;

        const res = await fetch(`/api/admin/tiers/${tierId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          originalValue = inputEl.value;
          showToast('Saved');

          // Update displayed tier info if name or price changed
          const tierWrapper = tierForm.closest('.tier-item-wrapper');
          if (tierWrapper) {
            if (field === 'name') {
              const nameEl = tierWrapper.querySelector('.tier-name');
              if (nameEl) nameEl.textContent = inputEl.value;
            }
            if (field === 'price') {
              const priceEl = tierWrapper.querySelector('.tier-price');
              if (priceEl) priceEl.textContent = `$${inputEl.value}`;
            }
          }
        } else {
          showToast(data.error || 'Save failed', 'error');
          inputEl.value = originalValue;
        }
      } catch (err) {
        showToast('Network error', 'error');
        inputEl.value = originalValue;
      }
    });
  });

  // DJ times autosave on blur
  function setupDjTimesAutosave(container: Element) {
    const inputs = container.querySelectorAll('.time-input[data-event-dj-id]');
    inputs.forEach(input => {
      const inputEl = input as HTMLInputElement;
      let originalValue = inputEl.value;

      inputEl.addEventListener('focus', () => {
        originalValue = inputEl.value;
      });

      inputEl.addEventListener('blur', async () => {
        if (inputEl.value === originalValue) return;

        const eventDjId = inputEl.dataset.eventDjId;
        if (!eventDjId) return;

        const field = inputEl.name; // slot_start or slot_end
        if (!field) return;

        try {
          const body: Record<string, any> = {};
          body[field] = inputEl.value;

          const res = await fetch(`/api/admin/event-djs/${eventDjId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });

          const data = await res.json();

          if (res.ok && data.success) {
            originalValue = inputEl.value;
            showToast('Saved');

            // Update displayed times
            const djItem = inputEl.closest('.dj-item');
            if (djItem && data.eventDj) {
              const timesDisplay = djItem.querySelector('.dj-times-display');
              const hasTimes = data.eventDj.slot_start || data.eventDj.slot_end;

              if (hasTimes) {
                const timesText = `${data.eventDj.slot_start || '?'} — ${data.eventDj.slot_end || '?'}`;
                if (timesDisplay) {
                  timesDisplay.textContent = timesText;
                } else {
                  // Create the times display if it doesn't exist
                  const header = djItem.querySelector('.dj-header');
                  if (header) {
                    const span = document.createElement('span');
                    span.className = 'dj-times-display';
                    span.textContent = timesText;
                    header.appendChild(span);
                  }
                }

                // Update the toggle text and data attribute
                const container = djItem.querySelector('.dj-times-container');
                const toggle = djItem.querySelector('.dj-times-toggle');
                if (container) container.setAttribute('data-has-times', 'true');
                if (toggle) toggle.textContent = '- Hide times';
              }
            }
          } else {
            showToast(data.error || 'Save failed', 'error');
            inputEl.value = originalValue;
          }
        } catch (err) {
          showToast('Network error', 'error');
          inputEl.value = originalValue;
        }
      });
    });
  }

  // Set up autosave for existing DJ items
  document.querySelectorAll('.dj-item').forEach(setupDjTimesAutosave);
</script>
