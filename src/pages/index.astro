---
import Base from '../layouts/Base.astro';
import VerbGrid from '../components/public/VerbGrid.astro';
import Footer from '../components/public/Footer.astro';
import HouseRulesModal from '../components/public/HouseRulesModal.astro';
import { getAllEvents, getPublishedEvents } from '../lib/supabase';
import type { TicketTier } from '../lib/supabase';
import { isEventPast } from '../lib/utils';

// Check if user is authenticated
const user = Astro.locals.user;

// Fetch events based on auth status:
// - Authenticated users see published + draft events
// - Public users see only published events
const events = user ? await getAllEvents() : await getPublishedEvents();
// Sort descending so newest events appear first
events.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Find the next upcoming event (event that hasn't ended yet)
const upcomingEvents = events
  .filter(e => !isEventPast(e))
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
const nextEventId = upcomingEvents.length > 0 ? upcomingEvents[0].id : null;
const nextEventDate = upcomingEvents.length > 0 ? upcomingEvents[0].date : null;

// Find the cheapest available online tier for the featured event
let featuredTier: TicketTier | null = null;
if (upcomingEvents.length > 0 && upcomingEvents[0].ticket_tiers) {
  const onlineTiers = (upcomingEvents[0].ticket_tiers as TicketTier[])
    .filter(t => t.tier_type === 'online' && t.is_active)
    .filter(t => t.max_stock === null || t.sold_count < t.max_stock) // Has stock
    .sort((a, b) => a.price - b.price);
  featuredTier = onlineTiers.length > 0 ? onlineTiers[0] : null;
}

---

<Base title="VERBS" description="Events and mixes from VERBS collective">
  <main>
    <VerbGrid events={events} isAuthenticated={!!user} featuredEventId={nextEventId} nextEventDate={nextEventDate} featuredTier={featuredTier} />
  </main>
  <Footer />
  {featuredTier && <HouseRulesModal />}
</Base>

<style>
  main {
    display: flex;
    flex-direction: column;
  }
</style>
